"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg>Book Appointment</a><button class=\"btn btn-ghost btn-sm Navbar-module__meLHSa__menuBtn\" aria-label=\"Toggle menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></div></header><main style=\"min-height:100vh\"><div class=\"page-module__vH1lIW__page\"><section class=\"page-module__vH1lIW__hero\"><div class=\"container\"><p class=\"page-module__vH1lIW__eyebrow\">Comprehensive Dental Care</p><h1 class=\"page-module__vH1lIW__heroTitle\">Our Dental Services</h1><p class=\"page-module__vH1lIW__heroSub\">From routine check-ups to advanced restorative procedures — expert care for your entire family under one roof.</p><div class=\"page-module__vH1lIW__heroStats\"><div class=\"page-module__vH1lIW__stat\"><strong>14+</strong><span>Treatments Available</span></div><div class=\"page-module__vH1lIW__statDivider\"></div><div class=\"page-module__vH1lIW__stat\"><strong>5K+</strong><span>Patients Treated</span></div><div class=\"page-module__vH1lIW__statDivider\"></div><div class=\"page-module__vH1lIW__stat\"><strong>25+</strong><span>Years of Excellence</span></div></div></div></section><section class=\"page-module__vH1lIW__gridSection\" aria-label=\"Services list\"><div class=\"container\"><div class=\"page-module__vH1lIW__grid\"><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about General Dentistry\" href=\"/services/general-dentistry\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"General Dentistry — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fgeneral%202.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fgeneral%202.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fgeneral%202.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fgeneral%202.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fgeneral%202.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fgeneral%202.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fgeneral%202.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fgeneral%202.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fgeneral%202.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fgeneral%202.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fgeneral%202.png&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">General Dentistry</h2><p class=\"page-module__vH1lIW__cardDesc\">Our general dentistry services form the foundation of your long-term oral health. We focus on prevention, early detection, and thorough care for patients of all ages.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of General Dentistry\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Comprehensive Oral Exams</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Professional Cleanings</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Oral Cancer Screening</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Scaling &amp; Polishing\" href=\"/services/scaling-polishing\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Scaling &amp; Polishing — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fscaling.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fscaling.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fscaling.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fscaling.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fscaling.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fscaling.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fscaling.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fscaling.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fscaling.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fscaling.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fscaling.png&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Scaling &amp; Polishing</h2><p class=\"page-module__vH1lIW__cardDesc\">Professional scaling and polishing removes hardened tartar deposits and stubborn surface stains that regular brushing cannot address, keeping your gums healthy and your smile radiant.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Scaling &amp; Polishing\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Tartar &amp; Plaque Removal</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Stain Elimination</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Gum Health Improvement</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Fresh Breath Restoration</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Teeth Whitening\" href=\"/services/teeth-whitening\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Teeth Whitening — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fteeth%20whitning.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fteeth%20whitning.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fteeth%20whitning.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Teeth Whitening</h2><p class=\"page-module__vH1lIW__cardDesc\">Our professional teeth whitening treatments use clinically proven bleaching agents to remove deep intrinsic and surface stains, delivering dramatically brighter results than over-the-counter products.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Teeth Whitening\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>In-Office Power Whitening</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Take-Home Custom Kits</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Safe for Enamel</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Lasting 12–24 Months</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Aesthetic Dental Treatments\" href=\"/services/aesthetic-treatments\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Aesthetic Dental Treatments — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fservices%2Faesthetic%20dentistry.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Aesthetic Dental Treatments</h2><p class=\"page-module__vH1lIW__cardDesc\">From porcelain veneers to composite bonding and smile makeovers, our aesthetic dentistry services are designed to create natural-looking, beautiful results that complement your face and personality.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Aesthetic Dental Treatments\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Porcelain Veneers</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Composite Bonding</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Smile Makeovers</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Gum Contouring</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Dental Fillings\" href=\"/services/dental-fillings\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Dental Fillings — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Ftoot_filling%20.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ftoot_filling%20.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Ftoot_filling%20.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Dental Fillings</h2><p class=\"page-module__vH1lIW__cardDesc\">Modern tooth-coloured composite fillings restore decayed or damaged teeth to full function and appearance, offering a natural result that blends seamlessly with your existing teeth.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Dental Fillings\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Tooth-Coloured Composite</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Metal-Free Options</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Single Appointment</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Strengthens Damaged Teeth</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Tooth Extractions\" href=\"/services/tooth-extractions\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Tooth Extractions — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fextraction%202.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fextraction%202.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fextraction%202.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fextraction%202.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fextraction%202.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fextraction%202.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fextraction%202.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fextraction%202.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fextraction%202.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fextraction%202.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fextraction%202.png&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Tooth Extractions</h2><p class=\"page-module__vH1lIW__cardDesc\">When a tooth is too severely damaged or infected to save, our experienced team performs extractions with the utmost care to minimise discomfort and support fast healing.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Tooth Extractions\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Simple &amp; Surgical Extractions</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Wisdom Tooth Removal</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Gentle Technique</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Post-Extraction Guidance</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Dental Crowns &amp; Bridges\" href=\"/services/dental-crowns-bridges\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Dental Crowns &amp; Bridges — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fservices%2Fphoto-1593022356769-11f762e25ed9-800.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Dental Crowns &amp; Bridges</h2><p class=\"page-module__vH1lIW__cardDesc\">Custom-made crowns restore severely damaged teeth to full function and appearance, while dental bridges replace missing teeth by anchoring a pontic between two crowned adjacent teeth.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Dental Crowns &amp; Bridges\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Porcelain &amp; Ceramic Crowns</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Fixed Dental Bridges</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Colour-Matched Restorations</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Long-Lasting Strength</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Dental Implants\" href=\"/services/dental-implants\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Dental Implants — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimplant.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimplant.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimplant.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimplant.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimplant.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimplant.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimplant.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimplant.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimplant.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimplant.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimplant.png&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Dental Implants</h2><p class=\"page-module__vH1lIW__cardDesc\">Dental implants are the most advanced, permanent solution for missing teeth. A titanium implant post is surgically placed in the jaw, then topped with a lifelike crown, functioning just like a natural tooth.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Dental Implants\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Permanent Tooth Replacement</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Preserves Jaw Bone</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Full Chewing Function</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Natural-Looking Result</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Dentures\" href=\"/services/dentures\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Dentures — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fdnetures.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fdnetures.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fdnetures.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fdnetures.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fdnetures.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fdnetures.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fdnetures.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fdnetures.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fdnetures.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fdnetures.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fdnetures.png&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Dentures</h2><p class=\"page-module__vH1lIW__cardDesc\">Custom-fitted full and partial dentures replace multiple missing teeth, restoring appearance and oral function. Modern dentures are more comfortable, natural-looking, and stable than ever before.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Dentures\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Full &amp; Partial Dentures</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Precision Custom Fit</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Implant-Supported Options</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Natural Appearance</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Orthodontic Treatment\" href=\"/services/orthodontic-treatment\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Orthodontic Treatment — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fservices%2Forthodontic%20treatment.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Orthodontic Treatment</h2><p class=\"page-module__vH1lIW__cardDesc\">From traditional braces to clear aligners, our orthodontic treatments correct misaligned teeth and bite issues for both teenagers and adults, improving both aesthetics and long-term oral health.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Orthodontic Treatment\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Clear Aligners</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Traditional Braces</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Retainers &amp; Maintenance</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Suitable for All Ages</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Root Canal Treatment\" href=\"/services/root-canal\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Root Canal Treatment — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Frootcanal.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Frootcanal.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Frootcanal.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Frootcanal.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Frootcanal.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Frootcanal.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Frootcanal.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Frootcanal.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Frootcanal.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Frootcanal.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Frootcanal.png&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Root Canal Treatment</h2><p class=\"page-module__vH1lIW__cardDesc\">Root canal treatment removes infected or inflamed pulp tissue from inside the tooth, relieving pain and saving the natural tooth from extraction. Modern techniques make the procedure far more comfortable than its reputation suggests.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Root Canal Treatment\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Tooth-Saving Procedure</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Pain-Free Treatment</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Same-Day Pain Relief</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Prevents Extraction</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Gum Disease Treatment\" href=\"/services/gum-disease-treatment\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Gum Disease Treatment — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fgum%20disease.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fgum%20disease.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fgum%20disease.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fgum%20disease.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fgum%20disease.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fgum%20disease.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fgum%20disease.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fgum%20disease.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fgum%20disease.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fgum%20disease.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fgum%20disease.png&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Gum Disease Treatment</h2><p class=\"page-module__vH1lIW__cardDesc\">Gum disease affects the majority of adults to some degree. Our periodontal treatments range from deep cleaning to advanced gum therapy, designed to halt disease progression and restore gum health.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Gum Disease Treatment\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Deep Scaling &amp; Root Planing</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Periodontal Assessment</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Antibiotic Therapy</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Ongoing Maintenance</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"page-module__vH1lIW__card\" aria-label=\"Learn more about Pediatric Dentistry\" href=\"/services/pediatric-dentistry\"><div class=\"page-module__vH1lIW__cardImgWrap\"><img alt=\"Pediatric Dentistry — dental service in Negombo, Sri Lanka\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"page-module__vH1lIW__cardImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fperiodic%20dentistry.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fperiodic%20dentistry.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fperiodic%20dentistry.png&amp;w=3840&amp;q=75\"/></div><div class=\"page-module__vH1lIW__cardBody\"><h2 class=\"page-module__vH1lIW__cardTitle\">Pediatric Dentistry</h2><p class=\"page-module__vH1lIW__cardDesc\">Our child-friendly dental services create a safe, positive experience for young patients from their very first visit. We focus on prevention, education, and building trust to last a lifetime.</p><ul class=\"page-module__vH1lIW__highlights\" aria-label=\"Key features of Pediatric Dentistry\"><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Infant &amp; Toddler Check-Ups</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Fissure Sealants</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Fluoride Treatments</span></li><li class=\"page-module__vH1lIW__highlight\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Dental Habit Counselling</span></li></ul><span class=\"page-module__vH1lIW__cardCta\" aria-hidden=\"true\">Learn More <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a></div></div></section><section class=\"page-module__vH1lIW__cta\" aria-label=\"Book a consultation\"><div class=\"container\"><div class=\"page-module__vH1lIW__ctaBox\"><h2>Not sure which treatment you need?</h2><p>Book a consultation and our specialists will assess your oral health and recommend the ideal treatment plan for you.</p><a class=\"btn btn-primary btn-xl\" href=\"/book\">Book a Consultation <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></section></div><!--$--><!--/$--></main><footer class=\"Footer-module__7ni7Ha__footer\"><div class=\"container Footer-module__7ni7Ha__grid\"><div><div class=\"Footer-module__7ni7Ha__logo\"><img alt=\"Charming Dental Clinic — Dental Clinic in Negombo, Sri Lanka\" loading=\"lazy\" width=\"250\" height=\"110\" decoding=\"async\" data-nimg=\"1\" class=\"Footer-module__7ni7Ha__logoLight\" style=\"color:transparent;object-fit:contain;object-position:left;width:auto;height:110px\" srcSet=\"/_next/image?url=%2Flogo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Flogo.png&amp;w=640&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.png&amp;w=640&amp;q=75\"/><img alt=\"\" aria-hidden=\"true\" loading=\"lazy\" width=\"250\" height=\"110\" decoding=\"async\" data-nimg=\"1\" class=\"Footer-module__7ni7Ha__logoDark\" style=\"color:transparent;object-fit:contain;object-position:left;width:auto;height:110px\" srcSet=\"/_next/image?url=%2Flogo_dark.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Flogo_dark.png&amp;w=640&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo_dark.png&amp;w=640&amp;q=75\"/></div><p class=\"Footer-module__7ni7Ha__tagline\">Creating confident smiles through compassionate, modern dental care in Negombo.</p><p class=\"Footer-module__7ni7Ha__trustBadge\">Trusted family dental care in Negombo since 2006.</p><div class=\"Footer-module__7ni7Ha__socials\" aria-label=\"Social media links\"><a href=\"https://facebook.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"Footer-module__7ni7Ha__socialIcon\" aria-label=\"Facebook\" title=\"Facebook\"><svg stroke=\"c