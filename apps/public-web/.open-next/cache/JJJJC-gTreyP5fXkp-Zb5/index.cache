container\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorGrid\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L32\\\",null,{\\\"direction\\\":\\\"left\\\",\\\"delay\\\":0,\\\"className\\\":\\\"page-module__Q1LIZq__doctorImageCol\\\",\\\"children\\\":[\\\"$\\\",\\\"$L33\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorImageWrapper\\\",\\\"children\\\":[\\\"$\\\",\\\"$L9\\\",null,{\\\"src\\\":\\\"/doctor_croped.jpg\\\",\\\"alt\\\":\\\"Dr. Chaaminda Paaris — Expert dentist at Charming Dental Clinic, Negombo\\\",\\\"fill\\\":true,\\\"style\\\":{\\\"objectFit\\\":\\\"cover\\\",\\\"objectPosition\\\":\\\"center\\\"},\\\"sizes\\\":\\\"(max-width: 992px) 100vw, 45vw\\\"}]}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorContentCol\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L23\\\",null,{\\\"delay\\\":0.1,\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorLabel\\\",\\\"children\\\":\\\"MEET THE DOCTOR\\\"}]}],[\\\"$\\\",\\\"$L23\\\",null,{\\\"delay\\\":0.2,\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorName\\\",\\\"children\\\":\\\"Dr. Chaaminda Paaris\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorSpecialty\\\",\\\"children\\\":\\\"Chief Dentist\\\"}]]}],[\\\"$\\\",\\\"$L23\\\",null,{\\\"delay\\\":0.35,\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorQualifications\\\",\\\"children\\\":[\\\"BDS (University of Peradeniya)\\\",[\\\"$\\\",\\\"br\\\",null,{}],\\\"DHDP (University of Colombo)\\\"]}]}],[\\\"$\\\",\\\"$L34\\\",null,{\\\"delay\\\":0.5,\\\"className\\\":\\\"page-module__Q1LIZq__doctorRegBadge\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\\\",\\\"key\\\":\\\"oel41y\\\"}]],\\\"className\\\":\\\"lucide-shield page-module__Q1LIZq__doctorRegIcon\\\",\\\"size\\\":18}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"SLMC Registration No. 1634\\\"}]]}],[\\\"$\\\",\\\"$L23\\\",null,{\\\"delay\\\":0.5,\\\"children\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorBio\\\",\\\"children\\\":\\\"Delivering trusted, ethical and patient-focused dental care with over two decades of clinical experience, combining modern dentistry with a gentle and compassionate approach.\\\"}]}],[\\\"$\\\",\\\"$L23\\\",null,{\\\"delay\\\":0.65,\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__doctorExpBadge\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__expNumber\\\",\\\"children\\\":\\\"25+\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__expText\\\",\\\"children\\\":[\\\"Years of\\\",[\\\"$\\\",\\\"br\\\",null,{}],\\\"Experience\\\"]}]]}]}]]}]]}]}]}]\\n\"])</script><script>self.__next_f.push([1,\"2a:[\\\"$\\\",\\\"$L35\\\",null,{\\\"reviews\\\":[{\\\"id\\\":\\\"752978a3-b30f-4969-9ce8-0e8cef4cb0fd\\\",\\\"patient_name\\\":\\\"Lasitha Pradeep\\\",\\\"content\\\":\\\"I cannot say enough good things about Charming Dental Clinic. I had been putting off a dental visit for almost two years out of pure anxiety, but a friend convinced me to try this clinic and I am so glad he did. From the moment I walked in, the atmosphere felt calm and professional rather than intimidating. The doctor was warm, understanding, and did not judge me at all for the time I had spent avoiding the dentist. We came up with a treatment plan together that I felt comfortable with, and we started with a thorough cleaning that made a huge difference. The team genuinely cares about your wellbeing and not just about completing a procedure and moving on. This is the dentist I have been looking for my whole life.\\\",\\\"rating\\\":5,\\\"created_at\\\":\\\"2026-05-31T06:54:41.217917+00:00\\\"},{\\\"id\\\":\\\"2c49453e-26e6-49f6-a4ce-1ce5be37b2ba\\\",\\\"patient_name\\\":\\\"Ishara Kumari\\\",\\\"content\\\":\\\"My experience at Charming Dental Clinic was absolutely fantastic from start to finish. I came in for braces consultation and was amazed by how knowledgeable and honest the doctor was. He showed me a realistic treatment plan, explained the expected duration, and answered every single question I had without making me feel like I was being rushed out the door. The clinic is beautifully maintained, with a relaxing atmosphere that really helps ease the usual dental visit nerves. The booking process was smooth, the staff remembered my name on my second visit which was a lovely personal touch. I have since started my orthodontic treatment and I am already seeing small improvements. Truly a top-tier clinic.\\\",\\\"rating\\\":5,\\\"created_at\\\":\\\"2026-05-26T06:54:41.217917+00:00\\\"},{\\\"id\\\":\\\"ea1cf955-661b-4e70-b819-e6ccb21f12da\\\",\\\"patient_name\\\":\\\"Chamara Rathnayaka\\\",\\\"content\\\":\\\"I visited Charming Dental Clinic for a complete dental checkup and X-rays, and I was really impressed by how thorough and detailed the examination was. The doctor identified a small cavity that I was not even aware of and explained exactly how we should treat it before it gets worse. Everything was communicated very clearly and I never felt rushed. The X-ray equipment is modern and the results were explained to me in simple terms with a digital display which was very helpful. The clinic also maintains a strong commitment to hygiene — I noticed all instruments are properly sterilized and the treatment rooms are immaculate. This is exactly the kind of professional dental care everyone deserves.\\\",\\\"rating\\\":5,\\\"created_at\\\":\\\"2026-05-21T06:54:41.217917+00:00\\\"},{\\\"id\\\":\\\"7b67db37-6ccf-4983-847f-b40d956a7ed8\\\",\\\"patient_name\\\":\\\"Thilini Wickrama\\\",\\\"content\\\":\\\"I had an emergency dental situation — a severe toothache that started on a Saturday evening. I called Charming Dental Clinic and was pleasantly surprised that they were able to accommodate me quickly. The staff were so understanding over the phone and made me feel like I was a priority. When I arrived, I was seen promptly and the doctor diagnosed the issue right away. I needed a root canal, which honestly I was terrified about, but the procedure was done with such skill and care that I barely felt any discomfort at all. After the treatment the pain was completely gone and I could finally sleep that night. I am so grateful for the care I received and will be a loyal patient for years to come.\\\",\\\"rating\\\":5,\\\"created_at\\\":\\\"2026-05-16T06:54:41.217917+00:00\\\"},{\\\"id\\\":\\\"36888219-6294-4dae-8264-3bb7384a4247\\\",\\\"patient_name\\\":\\\"Ruwan Bandara\\\",\\\"content\\\":\\\"Charming Dental Clinic is hands down the best dental clinic I have visited in Sri Lanka. I moved back from abroad recently and was worried I would not find quality dental care here that matched what I was used to overseas. I was completely wrong. The facilities are modern, the doctor is highly skilled, and the level of attention to detail is exceptional. I came in for teeth whitening and the results were outstanding — my teeth are noticeably brighter and the doctor made sure it was done safely without causing any sensitivity. The pricing is also very reasonable for the quality of care you receive. I will not be going anywhere else for my dental needs.\\\",\\\"rating\\\":5,\\\"created_at\\\":\\\"2026-05-11T06:54:41.217917+00:00\\\"},{\\\"id\\\":\\\"c875ceef-e314-4f3b-8617-f25afb84b18d\\\",\\\"patient_name\\\":\\\"Dilani Silva\\\",\\\"content\\\":\\\"Brought my 8-year-old son here for his first dental visit and I could not have asked for a better experience. I was a little worried about how he would react, but the doctor was amazing with children — incredibly patient, funny, and gentle. My son actually enjoyed the visit and has been asking when he can go back! We had a fluoride treatment and a thorough checkup done, and the doctor also gave us some really helpful advice on brushing habits for kids. The clinic environment is very child-friendly and calming. As a parent, it means everything to find a dentist who your child trusts. We will be regular patients from now on.\\\",\\\"rating\\\":5,\\\"created_at\\\":\\\"2026-05-06T06:54:41.217917+00:00\\\"},{\\\"id\\\":\\\"583cdf9a-1509-4874-8814-1b866a4c2662\\\",\\\"patient_name\\\":\\\"Kasun Jayawardena\\\",\\\"content\\\":\\\"I had a dental implant consultation at Charming Dental Clinic last month and I was thoroughly impressed by the level of expertise and care shown by the team. The doctor sat down with me for a full 30 minutes explaining all my options, the procedure timeline, and the costs involved — with zero pressure to commit on the spot. The clinic is well-equipped and very organized. I also noticed how respectful the staff are with every patient, making sure everyone feels heard and comfortable. I have since started my implant treatment and I am very happy with the progress so far. Highly recommended for anyone looking for quality dental care in Negombo.\\\",\\\"rating\\\":5,\\\"created_at\\\":\\\"2026-05-01T06:54:41.217917+00:00\\\"},{\\\"id\\\":\\\"81dbe1d4-f469-467e-9e89-c95641401254\\\",\\\"patient_name\\\":\\\"Sanduni Fernando\\\",\\\"content\\\":\\\"I was terrified of the dentist my whole life, but Charming Dental Clinic completely changed my perspective. I needed two fillings and a deep cleaning done, and I was honestly expecting pain and a stressful experience. Instead, the doctor was so calm and gentle throughout the entire procedure. He noticed I was nervous and kept checking in with me during the treatment, which was so reassuring. The clinic uses modern equipment and I could tell the hygiene standards are top-notch. The online booking system is also very convenient — I got my appointment confirmed quickly and even received a reminder beforehand. This is now my permanent dental home.\\\",\\\"rating\\\":5,\\\"created_at\\\":\\\"2026-04-26T06:54:41.217917+00:00\\\"}]}]\\n\"])</script><script>self.__next_f.push([1,\"2b:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__ctaBanner\\\",\\\"aria-label\\\":\\\"Book an Appointment\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"container\\\",\\\"children\\\":[\\\"$\\\",\\\"$L34\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__ctaContent\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"children\\\":\\\"Ready for a Healthier Smile?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Book your appointment today — morning and evening slots available.\\\"}],[\\\"$\\\",\\\"$L16\\\",null,{\\\"href\\\":\\\"/book\\\",\\\"className\\\":\\\"btn btn-accent btn-xl\\\",\\\"children\\\":[\\\"Schedule Your Appointment \\\",[\\\"$\\\",\\\"$L17\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$19:props:children:2:props:children:1:props:children:props:children:2:props:children:0:props:children:props:children:1:props:iconNode\\\",\\\"className\\\":\\\"lucide-arrow-right\\\",\\\"size\\\":18,\\\"aria-hidden\\\":\\\"true\\\"}]]}]]}]}]}]\\n\"])</script><script>self.__next_f.push([1,\"2e:[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"page-module__Q1LIZq__learnMore\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[\\\"Learn More \\\",[\\\"$\\\",\\\"$L17\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$19:props:children:2:props:children:1:props:children:props:children:2:props:children:0:props:children:props:children:1:props:iconNode\\\",\\\"className\\\":\\\"lucide-arrow-right\\\",\\\"size\\\":13}]]}]\\n2f:[\\\"$\\\",\\\"$L2d\\\",\\\"orthodontic-treatment\\\",{\\\"href\\\":\\\"/services/orthodontic-treatment\\\",\\\"className\\\":\\\"card page-modul